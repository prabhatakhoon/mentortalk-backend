# ──────────────────────────────────────────────────────────
# MentorTalk Backend — Environment Variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.
# ──────────────────────────────────────────────────────────

# ── API Gateway ─────────────────────────────────────────
# REST API Gateway ID (used in CLI deploy/route scripts, not read by Lambda code)
API_GATEWAY_ID=

# WebSocket API Gateway endpoint (HTTPS URL, used by Lambdas at runtime)
WS_ENDPOINT=

# ── CDN ─────────────────────────────────────────────────
# Base URL for serving profile photos and media files (e.g. S3 + CloudFront)
CDN_BASE_URL=

# ── Lambda ARNs (used for cross-Lambda invocation / EventBridge scheduling) ──
SCHEDULER_ROLE_ARN=
GRACE_PERIOD_LAMBDA_ARN=
FREE_CHAT_TIMEOUT_LAMBDA_ARN=
REQUEST_TIMEOUT_LAMBDA_ARN=
DISCONNECT_CHECK_LAMBDA_ARN=

# ── Step Functions ──────────────────────────────────────
SFN_ARN=

# ── Feature flags / config ──────────────────────────────
# Set to "true" to enable test-account seed wallet and skip some checks
ENABLE_TEST_ACCOUNT=false

# Date the platform launches (ISO format). Mentors see this as a countdown until then.
LAUNCH_DATE=

# Minimum session duration before payout is earned (seconds, default 60)
MIN_SESSION_DURATION_SECS=60

# ── Auth (mentortalk-auth only) ─────────────────────────
# JWT signing secret. In production this comes from Secrets Manager; only set
# as an env var for local testing with stub tooling.
JWT_SECRET=
